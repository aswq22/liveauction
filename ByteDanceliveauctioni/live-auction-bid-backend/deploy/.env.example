# Copy this file to deploy/.env for local Docker Compose runs.
# Keep real endpoints, access keys, and secrets out of the public repository.

AUCTION_STORAGE_PROVIDER=local
AUCTION_ENV=dev
AUCTION_WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
AUCTION_WS_ALLOW_MISSING_ORIGIN=true
AUCTION_WS_TICKET_TTL=60s
AUCTION_BID_SYNC_PROJECTION=false
AUCTION_RUNTIME_PROJECTION_SHARDS=16
AUCTION_RUNTIME_PROJECTION_DRAIN_BATCHES=8
AUCTION_RUNTIME_PROJECTION_BACKPRESSURE_PENDING_LIMIT=0
AUCTION_RUNTIME_PROJECTION_BACKPRESSURE_LAG=0s
AUCTION_RUNTIME_PROJECT_LEGACY_STREAMS=false
AUCTION_DB_MAX_OPEN_CONNS=20
AUCTION_DB_MAX_IDLE_CONNS=10
AUCTION_DB_CONN_MAX_LIFETIME=30m
AUCTION_DB_CONN_MAX_IDLE_TIME=2m
AUCTION_REDIS_POOL_SIZE=128
AUCTION_REDIS_MIN_IDLE_CONNS=16

# Lossy barrage admission and room-window controls. AUCTION_BARRAGE_WINDOW must
# be at least 1ms; invalid values fail backend startup. Active rooms are capped
# at 4096, per-room unique candidates are capped at 5000, and active-rooms *
# unique-per-room must not exceed 250000. Raising the active-room limit therefore
# requires lowering the per-room unique limit.
AUCTION_BARRAGE_QUEUE_CAPACITY=100000
AUCTION_BARRAGE_WINDOW=100ms
AUCTION_BARRAGE_MAX_ACTIVE_ROOMS_PER_WINDOW=32
AUCTION_BARRAGE_MAX_PER_ROOM_WINDOW=30
AUCTION_BARRAGE_ADMIN_RESERVED=3
AUCTION_BARRAGE_PAID_RESERVED=7
AUCTION_BARRAGE_MAX_UNIQUE_PER_ROOM_WINDOW=5000
AUCTION_BARRAGE_MAX_CONTENT_RUNES=100
AUCTION_BARRAGE_GLOBAL_USER_BURST=5
AUCTION_BARRAGE_GLOBAL_USER_RATE=2
AUCTION_BARRAGE_GLOBAL_RATE_ENTRY_CAPACITY=100000
AUCTION_BARRAGE_ROOM_USER_BURST=5
AUCTION_BARRAGE_ROOM_USER_RATE=2
AUCTION_BARRAGE_ROOM_RATE_ENTRY_CAPACITY=100000
# Optional comma-separated, case-insensitive substrings; empty disables this filter.
AUCTION_BARRAGE_SENSITIVE_WORDS=

# Realtime event bus. Production payment/order events use Outbox + RabbitMQ,
# and the WebSocket hub consumes the RabbitMQ queue for frontend fanout.
AUCTION_REALTIME_BUS=rabbitmq
AUCTION_REALTIME_BUS_RABBITMQ_URL=amqp://auction:auction_mq@rabbitmq:5672/
AUCTION_REALTIME_BUS_RABBITMQ_EXCHANGE=auction.events
AUCTION_REALTIME_BUS_RABBITMQ_ROUTING_KEY=auction.realtime.event
AUCTION_REALTIME_BUS_RABBITMQ_QUEUE=auction.realtime.websocket
AUCTION_REALTIME_BUS_RABBITMQ_PREFETCH=100

# Optional buyer AI semantic search.
# To enable locally, run docker compose with --profile search and set:
# AUCTION_SEARCH_PROVIDER=pgvector
# AUCTION_SEARCH_PG_DSN=postgres://auction_search:auction_search_dev@pgvector:5432/live_auction_search?sslmode=disable
# AUCTION_EMBEDDING_API_KEY=your_dashscope_key
AUCTION_SEARCH_PROVIDER=
# Production semantic retrieval is opt-in after explicit migrations/backfill,
# human quality assessment and real-database/load acceptance.
AUCTION_BUYER_SEARCH_ENABLED=false
AUCTION_SEARCH_CURSOR_KEY=
AUCTION_SEARCH_MAX_CONCURRENT=128
# Empty means forwarded client IPs are untrusted. Set only actual ingress CIDRs.
AUCTION_SEARCH_TRUSTED_PROXIES=
AUCTION_SEARCH_PG_DSN=
AUCTION_SEARCH_SYNC_INTERVAL=5m
AUCTION_SEARCH_SYNC_BATCH_LIMIT=500
AUCTION_SEARCH_HIDDEN_RETENTION=168h
AUCTION_SEARCH_PG_PASSWORD=auction_search_dev
AUCTION_EMBEDDING_PROVIDER=dashscope
# Operator-defined immutable deployment identity; must match generation provider-version.
AUCTION_EMBEDDING_PROVIDER_VERSION=
AUCTION_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AUCTION_EMBEDDING_MODEL=text-embedding-v4
AUCTION_EMBEDDING_DIMENSIONS=1024
AUCTION_EMBEDDING_BATCH_SIZE=10
AUCTION_EMBEDDING_TIMEOUT=8s
AUCTION_EMBEDDING_API_KEY=
AUCTION_AI_PROVIDER=mock
AUCTION_AI_BASE_URL=
AUCTION_AI_MODEL=
AUCTION_AI_TIMEOUT=8s
AUCTION_AI_MOCK_ON_FAILURE=true
AUCTION_AI_API_KEY=
AUCTION_PAYMENT_PROVIDER=mock

# Optional read-only auction planning runtime. The token below is a local-only
# Compose example; replace it outside local development and never commit a real secret.
# Start with: docker compose --profile agent up -d --build
AUCTION_AGENT_RUNTIME_ADDR=auction-agent:19081
AUCTION_AGENT_TOOL_GRPC_ADDR=:19082
AUCTION_INTERNAL_SERVICE_TOKEN=local-agent-service-token-change-me
AUCTION_TOOL_GRPC_ADDR=auction-backend:19082
AGENT_DATABASE_DSN=postgresql://auction_search:auction_search_dev@pgvector:5432/live_auction_search
AGENT_MODEL_PROVIDER=mock
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=
AGENT_MODEL_API_KEY=
AGENT_MODEL_TOKEN_LIMIT_FIELD=max_completion_tokens
AGENT_MODEL_TIMEOUT_SECONDS=30
AGENT_TOKEN_BUDGET=8192

AUCTION_LOCAL_STORAGE_DIR=/data/live-auction-assets
AUCTION_LOCAL_STORAGE_BUCKET=local
AUCTION_LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:18080/assets

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS_ENABLED=true
AUCTION_TOS_ENDPOINT=
AUCTION_TOS_REGION=
AUCTION_TOS_BUCKET=
AUCTION_TOS_PUBLIC_BASE_URL=
AUCTION_TOS_USE_SSL=true

# Temporary upload objects live under temp/{bizType}/yyyy/mm in OSS.
# They are marked attached when a lot is saved; otherwise delete is attempted on page leave
# and the backend cleanup worker removes expired temporary objects.
AUCTION_TEMP_ASSET_CLEANUP_INTERVAL=1h

AUCTION_TOS_ACCESS_KEY=
AUCTION_TOS_SECRET_KEY=
